# Copia este archivo como .env.local para probar en tu computador, y pon los mismos valores en Vercel
# (Settings → Environment Variables). NUNCA subas .env.local a GitHub.

# Secreto para firmar las sesiones y cifrar datos de pago. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Clave que escribes UNA vez para crear la cuenta del dueño (mínimo 8 caracteres).
OWNER_SETUP_KEY=

# Base de datos Postgres de Neon (Vercel la crea sola al conectar Storage → Neon).
DATABASE_URL=

# Correos de recuperación de clave (Resend).
RESEND_API_KEY=
MAIL_FROM="Minas del Live <no-responder@tu-dominio.com>"

# Opcional: llave de 32 bytes en base64 solo para cifrar datos de pago. Si falta, se deriva de SESSION_SECRET.
DATA_KEY=
